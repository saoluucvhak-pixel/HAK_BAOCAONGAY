# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for web files and scripts
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Windows batch files require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries
*.exe binary
*.dll binary
*.webp binary
*.png binary
*.ico binary
*.part binary
